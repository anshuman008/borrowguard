# Copy to .env (gitignored). All optional.

# Solana RPC. The public endpoint works for `monitor` and usually for
# `positions`; a dedicated RPC (Helius, Triton, ...) is more reliable.
RPC_URL=https://api.mainnet-beta.solana.com

# How monitor / watch hear about price moves between timer checks:
# poll (default), websocket, or grpc (build with `--features grpc`).
# BORROWGUARD_STREAM=websocket
# WS_URL=                # default: RPC_URL with wss://
# GRPC_URL=              # Yellowstone gRPC endpoint (Helius LaserStream, Triton, ...)
# GRPC_TOKEN=

# Alerts: sent when the controller's verdict changes (hold → delever, etc.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Execution (delever). Keypair file of the position owner, outside the repo.
# BORROWGUARD_KEYPAIR=~/.config/solana/borrowguard.json
# Optional: a Jupiter API key / alternative swap API base URL.
JUPITER_API_KEY=
# JUPITER_URL=https://lite-api.jup.ag/swap/v1
